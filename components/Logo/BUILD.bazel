# Bazel build for vetwo-circuit-background (Phase B, Batch 5).
#
# React component package with vitest tests.
# Tagged manual due to typescript@7.0.2 typo in package.json and
# ts_project incompatibility with Logo's tsconfig.

load("//bazel/macros:typecheck.bzl", "vetwo_typecheck")
load("//bazel/macros:tests.bzl", "vetwo_vitest")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")

vetwo_typecheck(
    name = "types",
    srcs = [
        "src/index.ts",
        "src/select.ts",
        "src/presets.ts",
        "src/VeTwoCircuitBackground.tsx",
        "src/VeTwoCircuitShowcase.tsx",
        "src/geometry/vetwoV2.ts",
    ],
    deps = [
        ":node_modules/@types/react",
        ":node_modules/@types/react-dom",
        ":node_modules/react",
        ":node_modules/react-dom",
        ":node_modules/typescript",
    ],
    tsconfig_json = "tsconfig.json",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

vetwo_vitest(
    name = "test",
    srcs = ["src/VeTwoCircuitBackground.test.tsx"],
    config = "vitest.config.ts",
    data = [
        "src/index.ts",
        "src/select.ts",
        "src/presets.ts",
        "src/VeTwoCircuitBackground.tsx",
        "src/VeTwoCircuitShowcase.tsx",
        "src/geometry/vetwoV2.ts",
        "package.json",
        "tsconfig.json",
        "vitest.setup.ts",
    ],
    deps = [":node_modules/@types/react", ":node_modules/jsdom"],
    tags = ["manual"],
    visibility = ["//visibility:public"],
)

npm_package(
    name = "pkg",
    srcs = ["package.json"],
    package = "vetwo-circuit-background",
    version = "0.1.0",
    tags = ["manual"],
    visibility = ["//visibility:public"],
)
